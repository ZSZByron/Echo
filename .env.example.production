# Echo Project Environment Variables Template (production)
# Copy this file to .env.production and fill in your actual values
# (.env.production is gitignored — never commit real keys)

# ========================================
# LLM Provider Configuration
# ========================================
ACTIVE_PROVIDER=deepseek

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic (Claude)
ANTHROPIC_API_KEY=your-anthropic-key-here

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-key-here

# Qwen/DashScope
QWEN_API_KEY=your-qwen-key-here

# Kimi/Moonshot
KIMI_API_KEY=your-kimi-key-here

# GLM/Zhipu
GLM_API_KEY=your-glm-key-here

# ========================================
# Backend Configuration
# ========================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=false

# Database — HONEST NOTE: current backend persists to SQLite only
# (container: /app/ugc.db for player state + /data volume for A1 JSON/assets).
# DATABASE_URL is NOT yet consumed by code; it becomes effective when the
# platform line (user module) adopts a real DB.
# DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/echo

# Auth — reserved for the platform line (user module not built yet);
# no real value needed for single-node deployment.
JWT_SECRET=change-me-when-user-module-lands

# ========================================
# Ports (docker-compose.production.yml)
# ========================================
WEB_PORT=80
API_PORT=8000

# ========================================
# Frontend
# ========================================
# Frontend calls same-origin relative /api (nginx reverse proxy in frontend image).
# VITE_API_URL is NOT consumed by current code — kept empty intentionally.
VITE_API_URL=

# ========================================
# Monitoring & Logging (Optional)
# ========================================
SENTRY_DSN=
LOG_LEVEL=INFO
