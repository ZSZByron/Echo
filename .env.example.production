# Echo Project Environment Variables Template
# Copy this file to .env and fill in your actual values

# ========================================
# LLM Provider Configuration
# ========================================
ACTIVE_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic (Claude)
ANTHROPIC_API_KEY=your-anthropic-key-here

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-key-here

# Qwen/DashScope
QWEN_API_KEY=your-qwen-key-here

# Kimi/Moonshot
KIMI_API_KEY=your-kimi-key-here

# GLM/Zhipu
GLM_API_KEY=your-glm-key-here

# ========================================
# Backend Configuration
# ========================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=false

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/echo.db

# ========================================
# Frontend Configuration
# ========================================
VITE_API_URL=http://localhost:8000

# ========================================
# Deployment Configuration (Optional)
# ========================================
DEPLOY_HOST=your-server.com
DEPLOY_USER=ubuntu
DEPLOY_SSH_KEY=path-to-your-ssh-key

# ========================================
# Cloud Storage (Optional - for frontend deployment)
# ========================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET=your-frontend-bucket

# ========================================
# CDN Configuration (Optional)
# ========================================
CLOUDFLARE_API_TOKEN=your-cloudflare-token
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id

# ========================================
# Monitoring & Logging (Optional)
# ========================================
SENTRY_DSN=your-sentry-dsn
LOG_LEVEL=INFO