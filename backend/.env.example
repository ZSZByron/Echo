# ===================================
# Multi-LLM Provider Configuration
# Echo UGC Backend - Provider Settings
# ===================================

# Active Provider (openai|anthropic|deepseek|qwen|kimi|glm)
ACTIVE_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- DeepSeek ---
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Qwen (DashScope) ---
QWEN_API_KEY=sk-your-qwen-key-here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# --- Kimi (Moonshot) ---
KIMI_API_KEY=sk-your-kimi-key-here
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# --- GLM (Zhipu) ---
GLM_API_KEY=your-glm-key-here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4

# ===================================
# Server Configuration
# ===================================
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=info

# ===================================
# Database Configuration
# ===================================
DATABASE_URL=sqlite+aiosqlite:///./ugc.db

# ===================================
# Image Generation Configuration
# ===================================

# Image provider (zhipu|wanxiang|wanxiang27|qwen|local)
IMAGE_PROVIDER=zhipu

# --- Zhipu (CogView-3-Plus) ---
ZHIPU_API_KEY=your-zhipu-api-key-here

# --- Wanxiang 2.5及以下 (DashScope text2image/image-synthesis, 异步轮询) ---
WANXIANG_API_KEY=your-wanxiang-api-key-here
WANXIANG_MODEL=wan2.5-t2i-preview  # 万相2.5及以下版本，异步路径

# --- Wanxiang 2.7 (DashScope multimodal-generation, 同步, 万相2.7图像) ---
# 复用同一个 DashScope API Key（与 WANXIANG_API_KEY 相同）
WANXIANG27_API_KEY=your-wanxiang27-api-key-here
WANXIANG27_MODEL=wan2.7-image-pro  # 可选: wan2.7-image-pro / wan2.7-image

# --- Qwen Image (DashScope multimodal-generation, 千问生图, 同步) ---
# 复用同一个 DashScope API Key（与 WANXIANG_API_KEY 相同）
QWEN_API_KEY=your-qwen-api-key-here
QWEN_IMAGE_MODEL=qwen-image-2.0-pro  # 可选: qwen-image-3.0-pro / qwen-image-2.0-pro 等

# --- Local Fallback (no API required) ---
# IMAGE_PROVIDER=local  # 使用本地生成（无需API密钥）
