# ===================================
# Multi-LLM Provider Configuration
# Echo UGC Backend - Provider Settings
# ===================================

# Active Provider (openai|anthropic|deepseek|qwen|kimi|glm)
ACTIVE_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- DeepSeek ---
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- Qwen (DashScope) ---
QWEN_API_KEY=sk-your-qwen-key-here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# --- Kimi (Moonshot) ---
KIMI_API_KEY=sk-your-kimi-key-here
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# --- GLM (Zhipu) ---
GLM_API_KEY=your-glm-key-here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4

# ===================================
# Server Configuration
# ===================================
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=info

# ===================================
# Database Configuration
# ===================================
DATABASE_URL=sqlite+aiosqlite:///./ugc.db

# ===================================
# Image Generation Configuration
# ===================================

# Image provider (zhipu|wanxiang|local)
IMAGE_PROVIDER=zhipu

# --- Zhipu (CogView-3-Plus) ---
ZHIPU_API_KEY=your-zhipu-api-key-here

# --- Wanxiang (DashScope) ---
WANXIANG_API_KEY=your-wanxiang-api-key-here
WANXIANG_MODEL=flux-dev  # 万相2.7使用flux-dev，也可用wanx-v1等

# --- Local Fallback (no API required) ---
# IMAGE_PROVIDER=local  # 使用本地生成（无需API密钥）
